  fullIngredientsText: "\u0E41\u0E1B\u0E49\u0E07\u0E2A\u0E32\u0E25\u0E35, \u0E44\u0E02\u0E48\u0E44\u0E01\u0E48,
    \u0E23\u0E34\u0E04\u0E2D\u0E15\u0E15\u0E49\u0E32\u0E0A\u0E35\u0E2A, \u0E1C\u0E31\u0E01\u0E42\u0E02\u0E21,
