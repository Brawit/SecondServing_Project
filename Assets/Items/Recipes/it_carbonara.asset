  obtainNote: "\u0E40\u0E0A\u0E1F\u0E2D\u0E34\u0E15\u0E32\u0E25\u0E35 \u0E09\u0E1A\u0E31\u0E1A\u0E41\u0E23\u0E01"
  mailShopLevel: 2
