  fullIngredientsText: "\u0E02\u0E49\u0E32\u0E27\u0E0D\u0E35\u0E48\u0E1B\u0E38\u0E48\u0E19,
    \u0E40\u0E19\u0E37\u0E49\u0E2D\u0E27\u0E31\u0E27\u0E2A\u0E44\u0E25\u0E0B\u0E4C,
    \u0E2B\u0E2D\u0E21\u0E2B\u0E31\u0E27\u0E43\u0E2B\u0E0D\u0E48, \u0E42\u0E0A\u0E22\u0E38,
    \u0E21\u0E34\u0E23\u0E34\u0E19, \u0E2A\u0E32\u0E40\u0E01\u0E1B\u0E23\u0E38\u0E07\u0E2D\u0E32\u0E2B\u0E32\u0E23,
    \u0E19\u0E49\u0E33\u0E15\u0E32\u0E25, \u0E02\u0E34\u0E07\u0E14\u0E2D\u0E07"
  sellPrice: 150
