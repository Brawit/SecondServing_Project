  fullIngredientsText: "\u0E02\u0E19\u0E21\u0E1B\u0E31\u0E07\u0E40\u0E1A\u0E2D\u0E23\u0E4C\u0E40\u0E01\u0E2D\u0E23\u0E4C,
    \u0E40\u0E19\u0E37\u0E49\u0E2D\u0E27\u0E31\u0E27\u0E1A\u0E14, \u0E40\u0E0A\u0E14\u0E14\u0E32\u0E23\u0E4C\u0E0A\u0E35\u0E2A,
    \u0E1C\u0E31\u0E01\u0E01\u0E32\u0E14\u0E2B\u0E2D\u0E21, \u0E21\u0E30\u0E40\u0E02\u0E37\u0E2D\u0E40\u0E17\u0E28,
    \u0E2B\u0E2D\u0E21\u0E2B\u0E31\u0E27\u0E43\u0E2B\u0E0D\u0E48, \u0E41\u0E15\u0E07\u0E01\u0E27\u0E32\u0E14\u0E2D\u0E07,
    \u0E0B\u0E2D\u0E2A\u0E21\u0E30\u0E40\u0E02\u0E37\u0E2D\u0E40\u0E17\u0E28, \u0E21\u0E31\u0E2A\u0E15\u0E32\u0E23\u0E4C\u0E14"
