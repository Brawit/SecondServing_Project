  fullIngredientsText: "\u0E40\u0E19\u0E37\u0E49\u0E2D\u0E2B\u0E21\u0E39\u0E2A\u0E31\u0E19\u0E19\u0E2D\u0E01,
    \u0E41\u0E1B\u0E49\u0E07\u0E2A\u0E32\u0E25\u0E35, \u0E44\u0E02\u0E48\u0E44\u0E01\u0E48,
    \u0E40\u0E01\u0E25\u0E47\u0E14\u0E02\u0E19\u0E21\u0E1B\u0E31\u0E07, \u0E01\u0E30\u0E2B\u0E25\u0E48\u0E33\u0E1B\u0E25\u0E35,
    \u0E0B\u0E2D\u0E2A\u0E17\u0E07\u0E04\u0E31\u0E15\u0E2A\u0E36, \u0E19\u0E49\u0E33\u0E21\u0E31\u0E19\u0E1E\u0E37\u0E0A"
  sellPrice: 125
  difficulty: 2
  cookingProfile: {fileID: 0}
  customSteps: []
  obtainSource: 1
  obtainNote: "\u0E40\u0E0A\u0E1F\u0E0D\u0E35\u0E48\u0E1B\u0E38\u0E48\u0E19"
  mailShopLevel: 2
  mailReputation: 920
  chef: {fileID: 11400000, guid: 0a29b0691cda5cc409134a7d16c56213, type: 2}
  letterBody: 'To the owner,


    Kenji. People online say your shop has become
    a place to rest. I am glad.


    Tonkatsu reminds me of my father. He was strict,
    and we rarely talked. But on exam days he would fry a pork cutlet for me, because
    "katsu" sounds like "to win." He never said good luck. The cutlet said it for
    him.


    Pound the pork, then flour, egg, and breadcrumbs. Fry until golden
    and crisp. Serve with shredded cabbage.


    Some people cannot say what they
    feel. Food can.'
